# Copy to .env and fill in. Never commit the filled-in .env — it is gitignored.
# Loaded by python-dotenv from backend/, so run backend commands from there.

# Google Gemini API key — used for both embeddings (gemini-embedding-001)
# and generation (gemini-2.5-flash).
# Get one at https://aistudio.google.com/apikey — the free tier is enough;
# ingest.py self-throttles to stay under its rate limit.
GOOGLE_API_KEY=

# Postgres + pgvector, matching docker-compose.yml.
# The +psycopg suffix is the SQLAlchemy form; db.py strips it for libpq.
# Leave as-is if you started the DB with `docker compose up -d db`.
DATABASE_URL=postgresql+psycopg://finpath:finpath@localhost:5432/finpath
